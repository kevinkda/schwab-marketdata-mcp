# Schwab Developer Portal credentials.
# Get these from: https://developer.schwab.com/dashboard/apps
#
# IMPORTANT:
#   * Copy this file to `.env` (which is git-ignored) before editing.
#   * Replace the `dummy-not-a-real-secret` placeholders with the real
#     values printed in your Schwab Developer Portal app dashboard.
#   * Never commit `.env`.  pre-commit (gitleaks + detect-secrets) will block
#     such commits when the hooks are installed.

SCHWAB_APP_KEY=dummy-not-a-real-secret  # pragma: allowlist secret
SCHWAB_APP_SECRET=dummy-not-a-real-secret  # pragma: allowlist secret

# This MUST exactly match the redirect URI registered in the Schwab Developer
# Portal app.  schwab-py defaults to https://127.0.0.1:8182 for `login_flow`
# and https://127.0.0.1 for `manual_flow`.
#
# IMPORTANT — if this value does not byte-for-byte match the redirect URI
# registered in your Schwab Developer Portal app (scheme, host, port,
# trailing slash), the OAuth flow will fail with
# `authlib.oauth2.rfc6749.errors.MismatchingStateException` ("CSRF Warning!")
# *after* you click Allow.  See docs/REGISTER.md "Troubleshooting".
# Use `python -m schwab_marketdata_mcp.auth login_flow --dry-run` to verify
# this without spawning a browser.
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# Optional: override per-minute request budget (default: 120).
# SCHWAB_RATE_LIMIT_PER_MIN=120

# Optional: max retries for 429 / 5xx (default: 2 for 429, 3 for 5xx).
# Set to 0 to disable retries (used by the integration tests).
# SCHWAB_MAX_RETRIES=2

# Optional: stderr log level (default: WARNING).
# LOG_LEVEL=WARNING

# DEVELOPMENT ONLY — switch to fixture-backed FakeSchwabClient.
# SCHWAB_MOCK_BACKEND=fixtures
# SCHWAB_MOCK_SCENARIO=normal
